{
  "schema_version": 2,
  "id": "squirrelpad",
  "name": "SquirrelPad",
  "game": "Conker's Bad Fur Day (N64) via CBFD-Recompiled",
  "kind": "disc-translation",
  "status": "experimental",
  "inputs": [
    {
      "type": "n64-rom",
      "formats": [
        "z64",
        "v64",
        "n64"
      ],
      "when": "build",
      "description": "Your own 64 MiB US ROM with big-endian bytes (SHA-1 4cbadd3c4e0729dec46af64ad018050eada4f47a). Byte-swapped ROMs are not supported; the extension does not determine byte order.",
      "accepted_sha256": [
        "32e6a8b970ec12ac5f782344945aa0c98a193832eefb687529d03bab6948714b"
      ]
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental",
        "windows-arm64": "experimental",
        "windows-x86_64": "experimental",
        "linux-arm64": "experimental",
        "linux-x86_64": "experimental"
      },
      "output": "ipa",
      "check": "ipa",
      "tools": [
        "git",
        "cmake",
        "ninja",
        "llvm",
        "libcxx"
      ],
      "published_app": "SquirrelPad-v{version}-ios-shell.ipa",
      "ios_module": {
        "file": "{work}/module/SquirrelPadGame.dylib",
        "into": "Frameworks/SquirrelPadGame.dylib",
        "on": [
          "windows",
          "linux"
        ]
      },
      "steps": [
        {
          "stage": "compile",
          "command": [
            "python3",
            "{repo}/scripts/build-personal.py",
            "--rom",
            "{disc}",
            "--sdk",
            "iphoneos",
            "--jobs",
            "{jobs}",
            "--output",
            "{output}"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "{python}",
            "{repo}/scripts/build-game-module.py",
            "--rom",
            "{disc}",
            "--toolchain",
            "{ios_toolchain}",
            "--build-dir",
            "{work}/module",
            "--jobs",
            "{jobs}"
          ],
          "on": [
            "windows",
            "linux"
          ]
        }
      ]
    }
  },
  "requirements": {
    "disk_gb": 6,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install Xcode command-line tools.",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install CMake: brew install cmake",
        "min_version": "3.28",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install Ninja: brew install ninja",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install Python 3.11 or newer: brew install python",
        "min_version": "3.11",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "sdl2-config",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install SDL2: brew install sdl2",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "pkg-config",
        "version_args": [
          "--modversion",
          "freetype2"
        ],
        "player": true,
        "label": "FreeType",
        "note": "Install pkgconf and FreeType: brew install pkgconf freetype",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "rg",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install ripgrep: brew install ripgrep",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "player": true,
        "note": "Install full Xcode, open it once, and install the iOS platform.",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "xcrun",
        "version_args": [
          "--sdk",
          "macosx",
          "metal",
          "--version"
        ],
        "player": true,
        "label": "Metal Toolchain",
        "note": "Install the Metal Toolchain in Xcode Settings > Components.",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "%ProgramFiles(x86)%/Microsoft Visual Studio/Installer/vswhere.exe",
        "version_args": [
          "-latest",
          "-products",
          "*",
          "-requiresAny",
          "-requires",
          "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
          "Microsoft.VisualStudio.Component.VC.Tools.ARM64",
          "-property",
          "installationVersion"
        ],
        "min_version": "17",
        "player": true,
        "hosts": [
          "windows-arm64"
        ],
        "label": "Visual Studio C++ Build Tools",
        "note": "Install Visual Studio 2022 Build Tools with Desktop development with C++ and a Windows SDK. On Windows x64, add the x64/x86 C++ tools. On Windows ARM64, add the ARM64 C++ tools (preferred) or the x64/x86 C++ tools."
      },
      {
        "name": "%ProgramFiles(x86)%/Microsoft Visual Studio/Installer/vswhere.exe",
        "version_args": [
          "-latest",
          "-products",
          "*",
          "-requires",
          "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
          "-property",
          "installationVersion"
        ],
        "min_version": "17",
        "player": true,
        "hosts": [
          "windows-x86_64"
        ],
        "label": "Visual Studio C++ Build Tools",
        "note": "Install Visual Studio 2022 Build Tools with Desktop development with C++, x64/x86 C++ tools and a Windows SDK."
      },
      {
        "name": "c++",
        "label": "C++ compiler",
        "version_args": [
          "--version"
        ],
        "player": true,
        "hosts": [
          "linux-arm64",
          "linux-x86_64"
        ],
        "note": "Install a C++ compiler and its standard library first: sudo apt install build-essential (Debian, Ubuntu, Chromebook Linux) or sudo dnf install gcc-c++ (Fedora)."
      }
    ]
  },
  "publication": {
    "public_binaries": false,
    "reason": "Personal apps contain native game code translated from the player-owned ROM. Publish source and the build recipe only."
  }
}
