+    void MetalDescriptorSet::setTexturePair(uint32_t firstIndex, const RenderTexture *first, RenderTextureLayout firstLayout, const RenderTexture *second, RenderTextureLayout secondLayout) {
+        const uint32_t secondIndex = firstIndex + 1;
+        if (device->useArgumentBuffersTier2 || first == nullptr || second == nullptr ||
+            secondIndex >= setLayout->descriptorBindingIndices.size()) {
+            RenderDescriptorSet::setTexturePair(firstIndex, first, firstLayout, second, secondLayout);
+            return;
+        }
+
+        const uint32_t firstBase = setLayout->descriptorIndexBases[firstIndex];
+        const uint32_t secondBase = setLayout->descriptorIndexBases[secondIndex];
+        const uint32_t firstBinding = setLayout->descriptorBindingIndices[firstIndex];
+        const uint32_t secondBinding = setLayout->descriptorBindingIndices[secondIndex];
+        const uint32_t firstArgument = firstIndex - firstBase + firstBinding;
+        const uint32_t secondArgument = secondIndex - secondBase + secondBinding;
+        if (secondArgument != firstArgument + 1 ||
+            mapDataType(setLayout->setBindings[firstBase].descriptorType) != MTL::DataTypeTexture ||
+            mapDataType(setLayout->setBindings[secondBase].descriptorType) != MTL::DataTypeTexture) {
+            RenderDescriptorSet::setTexturePair(firstIndex, first, firstLayout, second, secondLayout);
+            return;
+        }
+
+        MetalAutoreleasePool releasePool;
+        MTL::Texture *resources[2] = {
+            static_cast<const MetalTexture *>(first)->mtl,
+            static_cast<const MetalTexture *>(second)->mtl
+        };
+        const MTL::Texture *textures[2] = { resources[0], resources[1] };
+        argumentBuffer.argumentEncoder->setTextures(textures, NS::Range(firstArgument, 2));
+        if (argumentBuffer.mtl->storageMode() == MTL::StorageModeManaged) {
+            argumentBuffer.mtl->didModifyRange(NS::Range(argumentBuffer.offset, argumentBuffer.mtl->length() - argumentBuffer.offset));
+        }
+
+        const uint32_t indices[2] = { firstIndex, secondIndex };
+        const uint32_t bindings[2] = { firstBinding, secondBinding };
+        for (uint32_t i = 0; i < 2; i++) {
+            resources[i]->retain();
+            MTL::Resource *oldResource = resourceEntries[indices[i]].resource;
+            if (oldResource != nullptr) {
+                oldResource->release();
+            }
+            resourceEntries[indices[i]].resource = resources[i];
+            resourceEntries[indices[i]].type = getDescriptorType(bindings[i]);
+        }
+    }
