     return SampleInput(uvTexspace / gConstants.textureResolution);
 }
 
+// Optional SquirrelPad effects, applied to the completed game image. The zero
+// path preserves the original filter exactly. Native controls are composited later.
+float3 BrightPass(float2 uv) {
+    float3 color = SampleInput(uv).rgb;
+    float luma = dot(color, float3(0.2126f, 0.7152f, 0.0722f));
+    return color * smoothstep(0.55f, 0.95f, luma);
+}
+
 float4 PSMain(in float4 pos : SV_Position, in float2 uv : TEXCOORD0) : SV_TARGET {
 #ifdef PIXEL_ANTIALIASING
-    return PixelAntialiasing(uv);
+    float4 color = PixelAntialiasing(uv);
 #else
-    return SampleInput((uv / gConstants.textureResolution) * gConstants.videoResolution);
+    float4 color = SampleInput((uv / gConstants.textureResolution) * gConstants.videoResolution);
 #endif
+    uint effects = gConstants.presentationEffects;
+    if (effects == 0) return color;
+    float grade = float(effects & 255u) / 100.0f;
+    float glow = float((effects >> 8) & 255u) / 100.0f;
+    float clarity = float((effects >> 16) & 255u) / 100.0f;
+    float crt = float((effects >> 24) & 255u) / 100.0f;
+    float2 sourceUV = uv * gConstants.videoResolution / gConstants.textureResolution;
+    float2 texel = 1.0f / gConstants.textureResolution;
+
+    if (clarity > 0.0f) {
+        float3 n = SampleInput(sourceUV - float2(0, texel.y)).rgb;
+        float3 s = SampleInput(sourceUV + float2(0, texel.y)).rgb;
+        float3 e = SampleInput(sourceUV + float2(texel.x, 0)).rgb;
+        float3 w = SampleInput(sourceUV - float2(texel.x, 0)).rgb;
+        float3 low = min(color.rgb, min(min(n, s), min(e, w)));
+        float3 high = max(color.rgb, max(max(n, s), max(e, w)));
+        // Bounded unsharp mask; no new bright/dark halos outside local extrema.
+        color.rgb = clamp(color.rgb + (color.rgb - (n+s+e+w)*0.25f) * clarity * 0.8f, low, high);
+    }
+    if (glow > 0.0f) {
+        // A small, fixed-cost halo rather than a full HDR bloom pyramid.
+        float2 radius = 2.0f * gConstants.videoResolution / (float2(320, 240) * gConstants.textureResolution);
+        float3 halo = BrightPass(sourceUV + float2(radius.x, 0)) + BrightPass(sourceUV - float2(radius.x, 0));
+        halo += BrightPass(sourceUV + float2(0, radius.y)) + BrightPass(sourceUV - float2(0, radius.y));
+        halo += BrightPass(sourceUV + radius) + BrightPass(sourceUV - radius);
+        halo += BrightPass(sourceUV + float2(radius.x, -radius.y)) + BrightPass(sourceUV + float2(-radius.x, radius.y));
+        color.rgb += halo * (glow * 0.045f);
+    }
+    if (grade > 0.0f) {
+        float luma = dot(color.rgb, float3(0.2126f, 0.7152f, 0.0722f));
+        float3 vivid = lerp(float3(luma, luma, luma), color.rgb, 1.22f);
+        vivid = (vivid - 0.5f) * 1.10f + 0.5f;
+        color.rgb = lerp(color.rgb, vivid, grade);
+    }
+    if (crt > 0.0f) {
+        // Native-resolution scanlines; derivatives suppress moire at small sizes.
+        float row = uv.y * 240.0f;
+        float scan = 0.5f + 0.5f * cos(row * 6.2831853f);
+        float visibility = 1.0f - smoothstep(0.5f, 1.0f, fwidth(row));
+        color.rgb *= 1.0f - crt * 0.28f * scan * visibility;
+        float2 centered = uv * 2.0f - 1.0f;
+        color.rgb *= 1.0f - crt * 0.10f * saturate(dot(centered, centered) * 0.5f);
+    }
+    return float4(saturate(color.rgb), 1.0f);
 }
