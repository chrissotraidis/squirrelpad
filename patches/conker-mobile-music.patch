--- a/conker.toml
+++ b/conker.toml
@@ -379,3 +379,36 @@
 { extern int squirrelpad_mod_skip(uint8_t*, int); int skip = squirrelpad_mod_skip(rdram, (int)ctx->r4); if (skip >= 0) { ctx->r2 = skip; return; } }
 #endif
 """
+
+# func_10008CE8 (start a song on a sequence player) busy-waits for the audio thread
+# to stop the player, which on the N64 preempts it; here the loop has to yield for the
+# audio thread to run (issue #66). A hook at the head of each of its two wait loops,
+# before the n_alCSPGetState call (host/src/ultra_extras.cpp, conker_spin_wait_pass).
+[[patches.hook]]
+func = "func_10008CE8"
+before_vram = 0x10008D44
+text = "\n#ifdef SQUIRRELPAD_MOBILE_FIXES\n{ extern void conker_spin_wait_pass(uint8_t*, recomp_context*); conker_spin_wait_pass(rdram, ctx); }\n#endif\n"
+
+[[patches.hook]]
+func = "func_10008CE8"
+before_vram = 0x10008D98
+text = "\n#ifdef SQUIRRELPAD_MOBILE_FIXES\n{ extern void conker_spin_wait_pass(uint8_t*, recomp_context*); conker_spin_wait_pass(rdram, ctx); }\n#endif\n"
+
+# A song just started reads as stopped until the audio thread takes it up, and the music manager
+# took such a player for free while it played on (issue #66). So it reads as playing until then
+# (host/src/ultra_extras.cpp): marked when func_10008CE8 starts the song, the mark cleared when
+# func_10008F24 stops the player, and func_1000853C (a player's state) answers "playing" meanwhile.
+[[patches.hook]]
+func = "func_10008CE8"
+before_vram = 0x10008EC4
+text = "\n#ifdef SQUIRRELPAD_MOBILE_FIXES\n{ extern void conker_song_started(uint8_t*, recomp_context*); conker_song_started(rdram, ctx); }\n#endif\n"
+
+[[patches.hook]]
+func = "func_1000853C"
+before_vram = 0x10008560
+text = "\n#ifdef SQUIRRELPAD_MOBILE_FIXES\n{ extern void conker_song_state(uint8_t*, recomp_context*); conker_song_state(rdram, ctx); }\n#endif\n"
+
+[[patches.hook]]
+func = "func_10008F24"
+before_vram = 0x10008F24
+text = "\n#ifdef SQUIRRELPAD_MOBILE_FIXES\n{ extern void conker_song_stopped(uint8_t*, recomp_context*); conker_song_stopped(rdram, ctx); }\n#endif\n"
